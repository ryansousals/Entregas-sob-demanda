# Contas e pedidos de demonstração, apenas para uso local.
SEED_DEMO=true
VITE_DEMO_MODE=true

# Preço em reais: taxa fixa + distância informada em km × preço por km.
DELIVERY_BASE_FEE=10
DELIVERY_PER_KM=2
