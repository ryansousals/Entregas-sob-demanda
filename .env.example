# npm run local:init gera as credenciais e URLs automaticamente.
POSTGRES_USER=entregaja
POSTGRES_PASSWORD=GERAR_AUTOMATICAMENTE
POSTGRES_DB=entregaja
DB_PORT=5432
API_PORT=3000
APP_PORT=8080
